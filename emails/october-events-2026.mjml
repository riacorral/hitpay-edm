  <mj-section background-color="#002771" padding="16px 32px">
    <mj-column>
      <mj-text font-size="24px" font-weight="700" color="#FFFFFF" line-height="1.3" padding="0">Get more from HitPay: 5 events to join this October</mj-text>
      
