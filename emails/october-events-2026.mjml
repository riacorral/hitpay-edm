  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text align="left" font-size="14px" color="#61667C" line-height="1.6" padding="0">Join us this October for five sessions to help you simplify your finances, make everyday admin easier, and build useful tools for your business.</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 32px">
