<mjml>
  <mj-head>
    <mj-font name="Manrope" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&display=swap" />
    <mj-preview>Send and approve payments globally from one dashboard</mj-preview>
    <mj-attributes>
      <mj-all font-family="Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif" />
      <mj-section padding="0" background-color="#FFFFFF" />
      <mj-column padding="0" />
      <mj-text font-family="Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif" padding="0" />
      <mj-image padding="0" />
    </mj-attributes>
    <mj-style>
      a { color: inherit; text-decoration: none; }
      p { margin: 0 !important; }
      /* Mobile-order (text, then image) duplicate of img-text-wrap — hidden until the
         mobile breakpoint swaps it in, so degradation without media-query support
         still shows the (desktop-ordered) img-text-wrap table rather than nothing. */
      table.img-text-mobile { display: none; }
      @media only screen and (max-width:480px) {
        /* Swap to the mobile-ordered table instead of stacking img-text-wrap in
           place, since img-text-wrap's column order follows desktop imagePosition
           (image can be first) and we always want text before image on mobile. */
        table.img-text-wrap { display: none !important; }
        table.img-text-mobile { display: block !important; }
        table.img-text-mobile tr { display: block !important; }
        table.img-text-mobile td.img-text-img,
        table.img-text-mobile td.img-text-body { display: block !important; width: 100% !important; max-width: 100% !important; box-sizing: border-box !important; padding: 0 !important; }
        table.img-text-mobile td.img-text-img { padding-top: 16px !important; }
        table.img-text-mobile td.img-text-img img { width: 100% !important; height: auto !important; }
        /* Stack stat/column cards vertically on mobile */
        table.col-wrap tr { display: block !important; }
        td.col-card { display: block !important; width: 100% !important; max-width: 100% !important; box-sizing: border-box !important; margin-bottom: 8px !important; }
        td.col-spacer { display: none !important; width: 0 !important; }
        /* Wrap secondary eyebrow pill text onto its own line */
        .eyebrow-sep { display: none !important; }
        .eyebrow-break { display: block !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F0F2F5" width="600px">
    
  <mj-section background-color="#002771" padding="48px 32px 0">
    <mj-column>
      <mj-raw><table align="center" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto 20px;"><tr>
        <td style="background-color:rgba(255,255,255,0.10);border-radius:20px;padding:6px 18px;font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:11px;font-weight:600;color:#FFFFFF;letter-spacing:0.8px;text-transform:uppercase;text-align:center;white-space:normal;">
          <span style="white-space:nowrap;">🚀 New Product · BillPay</span>
        </td>
      </tr></table></mj-raw>
      <mj-text align="center" font-size="28px" font-weight="700" color="#FFFFFF" line-height="1.2" padding="0 0 16px">Pay suppliers &amp; invoices<br/>as easy as getting paid.</mj-text>
      <mj-text align="center" font-size="15px" color="#D4D9E0" line-height="1.5" padding="0 8px 24px">Capture, approve, and pay suppliers - locally and overseas - right from the HitPay dashboard you already use to get paid.</mj-text>
      <mj-image src="img/billpay-hero-video.png" alt="Pay suppliers &amp; invoices
as easy as getting paid." href="https://youtu.be/InNmUHALQJo" border="2px solid #FFFFFF" border-radius="12px 12px 0 0" padding="0" />
    </mj-column>
  </mj-section>
    <mj-section padding="32px 0 0" background-color="#FFFFFF"><mj-column /></mj-section>
    
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text align="left" font-size="14px" color="#61667C" line-height="1.6" padding="0">Hi {firstName},</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text align="left" font-size="14px" color="#61667C" line-height="1.6" padding="0">Right now, paying suppliers means chasing invoices and logging into your bank one payment at a time. BillPay brings it all into HitPay - forward or upload an invoice, approve it, pay it, and watch it sync to Xero automatically.</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    
    <mj-column>
      <mj-text align="center" font-size="36px" font-weight="700" color="#2465DE" line-height="1.2" padding="0 0 4px">100+</mj-text>
      <mj-text align="center" font-size="14px" color="#61667C" padding="0 0 16px">Currencies</mj-text>
    </mj-column>
    <mj-column>
      <mj-text align="center" font-size="36px" font-weight="700" color="#2465DE" line-height="1.2" padding="0 0 4px">40+</mj-text>
      <mj-text align="center" font-size="14px" color="#61667C" padding="0 0 16px">Countries</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 24px">
    <mj-column>
      <mj-divider border-color="#D4D9E0" border-width="1px" padding="8px 0 0" />
    </mj-column>
  </mj-section>
  <mj-section padding="16px 32px 24px">
    <mj-column>
      <mj-text align="left" font-size="16px" font-weight="700" color="#002771" line-height="1.3" padding="0">How It Works</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 24px">
    <mj-column padding="0">
      <mj-raw><table class="col-wrap" width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation"><tbody><tr><td width="173" class="col-card" valign="top" bgcolor="#F5F7FC" align="center" style="background-color:#F5F7FC;border-radius:8px;padding:16px 12px;width:173px;text-align:center;">
          <div style="text-align:center;font-size:20px;line-height:1.2;margin:0 0 6px 0;font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;">✉️</div><div style="text-align:center;font-size:22px;font-weight:700;color:#002771;line-height:1.1;margin:0 0 10px 0;font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;">Upload/Forward</div><p style="text-align:center;font-size:12px;color:#61667C;line-height:1.6;margin:6px 0 0 0;font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;">Email an invoice to your BillPay inbox or upload it from your dashboard - no template needed.</p>
        </td><td width="8" class="col-spacer" style="width:8px;font-size:0;line-height:0;"> </td><td width="173" class="col-card" valign="top" bgcolor="#F5F7FC" align="center" style="background-color:#F5F7FC;border-radius:8px;padding:16px 12px;width:173px;text-align:center;">
          <div style="text-align:center;font-size:20px;line-height:1.2;margin:0 0 6px 0;font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;">✅</div><div style="text-align:center;font-size:22px;font-weight:700;color:#002771;line-height:1.1;margin:0 0 10px 0;font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;">Approve</div><p style="text-align:center;font-size:12px;color:#61667C;line-height:1.6;margin:6px 0 0 0;font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;">OCR pulls out the details, and your approval workflow routes it to the right person.</p>
        </td><td width="8" class="col-spacer" style="width:8px;font-size:0;line-height:0;"> </td><td width="173" class="col-card" valign="top" bgcolor="#F5F7FC" align="center" style="background-color:#F5F7FC;border-radius:8px;padding:16px 12px;width:173px;text-align:center;">
          <div style="text-align:center;font-size:20px;line-height:1.2;margin:0 0 6px 0;font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;">💸</div><div style="text-align:center;font-size:22px;font-weight:700;color:#002771;line-height:1.1;margin:0 0 10px 0;font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;">Paid</div><p style="text-align:center;font-size:12px;color:#61667C;line-height:1.6;margin:6px 0 0 0;font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;">Fund it via PayNow or bank transfer, on the date you choose.</p>
        </td></tr></tbody></table></mj-raw>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text align="left" font-size="14px" color="#61667C" line-height="1.6" padding="0">Log in to your HitPay Dashboard, then go to <b style="color:#03102F;">Finance &gt; Bills</b> to get started.</mj-text>
    </mj-column>
  </mj-section>
