  <mj-section padding="16px 32px 24px">
    <mj-column>
      <mj-text font-size="16px" font-weight="700" color="#002771" line-height="1.3" padding="0">The right sign-off before money moves</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="14px" color="#61667C" line-height="1.6" padding="0">Select the bills that are ready, review the total, and release them together — instead of opening your bank portal 50 times for 50 payments.</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-raw>
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:8px;">
