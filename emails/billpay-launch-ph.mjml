  <mj-section padding="16px 32px 24px">
    <mj-column>
      <mj-text align="left" font-size="16px" font-weight="700" color="#002771" line-height="1.3" padding="0">How BillPay Is Different From the Rest</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text align="left" font-size="14px" color="#61667C" line-height="1.6" padding="0">No monthly platform fee, and one account for both payments in and payments out - here's how BillPay stacks up against the alternatives in the Philippines.</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="16px 32px 16px">
    <mj-column>
      <mj-image src="img/billpay-comparison-ph.png" alt="Comparison of HitPay BillPay against a business bank and Wise Business across cost, bill capture, approvals, local rails, Xero sync, and batch payments" border-radius="8px" padding="0" />
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 24px">
    <mj-column>
      <mj-divider border-color="#D4D9E0" border-width="1px" padding="8px 0 0" />
    </mj-column>
  </mj-section>
