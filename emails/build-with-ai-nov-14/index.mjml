<mjml>
  <mj-head>
    <mj-font name="Manrope" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&amp;display=swap" />
    <mj-preview>One day, one real business problem, one working tool. No coding background needed</mj-preview>
    <mj-attributes>
      <mj-all font-family="Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif" />
      <mj-section padding="0" background-color="#FFFFFF" />
      <mj-column padding="0" />
      <mj-text font-family="Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif" padding="0" />
      <mj-image padding="0" />
    </mj-attributes>
    <mj-style>
      a { color: inherit; text-decoration: none; }
      p { margin: 0 !important; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F0F2F5" width="600px">
  <mj-section padding="24px 0 0" background-color="#F0F2F5"><mj-column /></mj-section>
  <mj-section padding="32px 32px 20px"><mj-column><mj-image src="img/inline-1.png" alt="HitPay" width="110px" align="left" /></mj-column></mj-section>
  <mj-section padding="0 32px"><mj-column><mj-image src="img/hero.jpg" alt="Build with AI: Hands-On Coding Workshop for SMEs" href="https://luma.com/LUMA-TBC?utm_source=email&amp;utm_medium=email&amp;utm_campaign=build-with-ai-nov-14&amp;utm_content=1-hero" border-radius="12px" fluid-on-mobile="true" /></mj-column></mj-section>
  <mj-section padding="28px 32px 8px"><mj-column><mj-raw><div style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#2465DE;margin:0 0 12px 0;">You're invited · Saturday, 14 November</div></mj-raw><mj-text font-size="28px" font-weight="800" color="#002771" line-height="1.25">Build your own business software in one day.</mj-text></mj-column></mj-section>
  <mj-section padding="8px 32px 24px"><mj-column><mj-text font-size="15px" color="#61667C" line-height="1.65">Hi {firstName},<br/><br/>Build with AI is back on 14 November. Bring one task that eats up your week, and spend the day turning it into a working tool with Claude as your coding co-pilot. No coding background needed.</mj-text></mj-column></mj-section>
  <mj-section padding="0 32px 28px"><mj-column><mj-raw><table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F5F7FC;border-radius:12px;border-collapse:separate;"><tr><td style="padding:22px 22px 8px 22px;"><table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:14px;"><tr>
<td width="48" valign="top" style="width:48px;"><img src="img/icon-calendar.png" width="40" height="40" alt="" style="display:block;border:0;" /></td>
<td valign="middle" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;padding-left:4px;"><div style="font-size:15px;font-weight:700;color:#002771;line-height:1.4;">Saturday, 14 November 2026</div></td></tr></table><table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:14px;"><tr>
<td width="48" valign="top" style="width:48px;"><img src="img/icon-clock.png" width="40" height="40" alt="" style="display:block;border:0;" /></td>
<td valign="middle" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;padding-left:4px;"><div style="font-size:15px;font-weight:700;color:#002771;line-height:1.4;">10am to 5pm SGT</div></td></tr></table><table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:14px;"><tr>
<td width="48" valign="top" style="width:48px;"><img src="img/icon-pin.png" width="40" height="40" alt="" style="display:block;border:0;" /></td>
<td valign="middle" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;padding-left:4px;"><div style="font-size:15px;font-weight:700;color:#002771;line-height:1.4;">In person, Singapore</div><div style="font-size:13px;color:#61667C;line-height:1.5;">Venue details on Luma</div></td></tr></table></td></tr></table></mj-raw></mj-column></mj-section>
  <mj-section padding="0 32px 36px"><mj-column><mj-raw><table cellpadding="0" cellspacing="0" border="0"><tr><td bgcolor="#2465DE" style="background-color:#2465DE;border-radius:8px;"><a href="https://luma.com/LUMA-TBC?utm_source=email&amp;utm_medium=email&amp;utm_campaign=build-with-ai-nov-14&amp;utm_content=2-register-for-a-spot" style="display:inline-block;padding:14px 28px;font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:15px;font-weight:700;color:#FFFFFF;text-decoration:none;">Register for a spot →</a></td></tr></table></mj-raw></mj-column></mj-section>
  <mj-section padding="0 32px 8px"><mj-column><mj-raw><div style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#2465DE;margin:0 0 12px 0;">What you will do</div></mj-raw></mj-column></mj-section>
  <mj-section padding="0 32px 28px"><mj-column><mj-raw><table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:14px;"><tr>
<td width="48" valign="top" style="width:48px;"><img src="img/icon-tools.png" width="40" height="40" alt="" style="display:block;border:0;" /></td>
<td valign="middle" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;padding-left:4px;"><div style="font-size:15px;font-weight:700;color:#002771;line-height:1.4;">Build with an AI co-pilot</div><div style="font-size:13px;color:#61667C;line-height:1.5;">Use Claude to create functional software without a technical background</div></td></tr></table><table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:14px;"><tr>
<td width="48" valign="top" style="width:48px;"><img src="img/icon-clock.png" width="40" height="40" alt="" style="display:block;border:0;" /></td>
<td valign="middle" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;padding-left:4px;"><div style="font-size:15px;font-weight:700;color:#002771;line-height:1.4;">Automate a real process</div><div style="font-size:13px;color:#61667C;line-height:1.5;">Pick one bottleneck in your business and fix it</div></td></tr></table><table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:14px;"><tr>
<td width="48" valign="top" style="width:48px;"><img src="img/icon-people.png" width="40" height="40" alt="" style="display:block;border:0;" /></td>
<td valign="middle" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;padding-left:4px;"><div style="font-size:15px;font-weight:700;color:#002771;line-height:1.4;">Walk out with a prototype</div><div style="font-size:13px;color:#61667C;line-height:1.5;">Something you can actually use, built in a small, hands-on cohort</div></td></tr></table></mj-raw></mj-column></mj-section>
  <mj-section padding="0 32px 8px"><mj-column><mj-raw><div style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#2465DE;margin:0 0 12px 0;">Before you come</div></mj-raw></mj-column></mj-section>
  <mj-section padding="0 32px 28px"><mj-column><mj-text font-size="15px" color="#61667C" line-height="1.65">Bring a laptop and a paid Claude Pro plan (Anthropic), approx. SGD $25/month. Spots are limited and registration is subject to approval. Approved registrations will receive a confirmation email with full event details.</mj-text></mj-column></mj-section>
  <mj-section padding="0 32px 36px"><mj-column><mj-raw><table cellpadding="0" cellspacing="0" border="0"><tr><td bgcolor="#2465DE" style="background-color:#2465DE;border-radius:8px;"><a href="https://luma.com/LUMA-TBC?utm_source=email&amp;utm_medium=email&amp;utm_campaign=build-with-ai-nov-14&amp;utm_content=3-i-want-in" style="display:inline-block;padding:14px 28px;font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:15px;font-weight:700;color:#FFFFFF;text-decoration:none;">I want in →</a></td></tr></table></mj-raw></mj-column></mj-section>
  <mj-section padding="0 32px 16px"><mj-column><mj-text font-size="14px" color="#61667C" line-height="1.6">Questions? Reply to this email and we will help you out.</mj-text></mj-column></mj-section>
  <mj-section padding="0 32px 32px"><mj-column><mj-text font-size="14px" color="#61667C" line-height="1.6"><b style="color:#03102F;">The HitPay Team</b></mj-text></mj-column></mj-section>
  <mj-section background-color="#F9F9F6" padding="24px 32px 16px">
    <mj-column>
      <mj-text align="center" padding="0">
        <a href="https://www.hitpayapp.com" style="display:inline-block;vertical-align:middle;margin-right:14px;"><img src="img/logogram.png" width="24" height="24" alt="HitPay" style="display:inline-block;border-radius:50%;vertical-align:middle;" /></a><a href="https://www.instagram.com/hitpayapp" style="display:inline-block;vertical-align:middle;margin:0 3px;"><img src="img/inline-2.png" width="24" height="24" alt="Instagram" style="display:inline-block;border-radius:50%;vertical-align:middle;" /></a><a href="https://www.facebook.com/hitpayapp" style="display:inline-block;vertical-align:middle;margin:0 3px;"><img src="img/inline-3.png" width="24" height="24" alt="Facebook" style="display:inline-block;border-radius:50%;vertical-align:middle;" /></a><a href="https://www.linkedin.com/company/hit-pay/" style="display:inline-block;vertical-align:middle;margin:0 3px;"><img src="img/inline-4.png" width="24" height="24" alt="LinkedIn" style="display:inline-block;border-radius:50%;vertical-align:middle;" /></a><a href="https://www.tiktok.com/@hitpayapp" style="display:inline-block;vertical-align:middle;margin:0 3px;"><img src="img/inline-5.png" width="24" height="24" alt="TikTok" style="display:inline-block;border-radius:50%;vertical-align:middle;" /></a><a href="https://www.youtube.com/@hitpayapp" style="display:inline-block;vertical-align:middle;margin:0 3px;"><img src="img/inline-6.png" width="24" height="24" alt="YouTube" style="display:inline-block;border-radius:50%;vertical-align:middle;" /></a>
      </mj-text>
    </mj-column>
  </mj-section>
  <mj-section background-color="#F9F9F6" padding="0"><mj-column padding="0"><mj-image src="img/inline-7.png" alt="HitPay products" width="600px" padding="0" /></mj-column></mj-section>
  <mj-section background-color="#F9F9F6" padding="12px 32px 24px">
    <mj-column>
      <mj-divider border-color="#D4D9E0" border-width="1px" padding="0 0 12px" />
      <mj-text align="center" font-size="11px" color="#9295A5" line-height="16px" padding="0 0 4px">HitPay Payment Solutions Pte Ltd</mj-text>
      <mj-text align="center" font-size="9px" color="#D4D9E0" line-height="14px" padding="0"><a href="{unsubscribe_link}" style="color:#D4D9E0;text-decoration:none;font-size:9px;">Unsubscribe</a></mj-text>
    </mj-column>
  </mj-section>
  </mj-body>
</mjml>