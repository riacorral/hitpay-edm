        td.col-spacer { display: none !important; width: 0 !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F0F2F5" width="600px">
    
  <mj-section background-color="#002771" padding="48px 32px 0">
    <mj-column>
      <mj-text align="center" font-size="11px" font-weight="600" color="#D4D9E0" letter-spacing="1.5px" text-transform="uppercase" padding="0 0 8px">Product Announcement</mj-text>
      <mj-text align="center" font-size="28px" font-weight="700" color="#FFFFFF" line-height="1.2" padding="0 0 16px">Welcome Malaysian Shoppers: Accept DuitNow QR in Singapore</mj-text>
      
      <mj-image src="file:///Users/riacorral/Documents/HitPay-Claude/hitpay-edm-main/emails/images/duitnow-hero-main.jpg" alt="Welcome Malaysian Shoppers: Accept DuitNow QR in Singapore" border-radius="8px 8px 0 0" padding="0" />
    </mj-column>
  </mj-section>
    <mj-section padding="32px 0 0" background-color="#FFFFFF"><mj-column /></mj-section>
    
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="14px" color="#61667C" line-height="1.6" padding="0">Malaysia's national payment standard is now available for Singapore merchants. No Malaysian entity required.</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 24px">
    <mj-column>
      <mj-divider border-color="#D4D9E0" border-width="1px" padding="8px 0 0" />
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="24px" font-weight="700" color="#002771" line-height="1.3" padding="0">Why DuitNow Matters for Singapore Businesses</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="14px" color="#61667C" line-height="1.6" padding="0">Every day, Malaysian visitors walk into Singapore stores, sit at your tables, and browse your online shop, ready to spend. But if you don't accept DuitNow, you're invisible to them at checkout.</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="14px" color="#61667C" line-height="1.6" padding="0">DuitNow is Malaysia's national payment standard, embedded in every major Malaysian banking app. It's how millions of Malaysians pay, and they expect to use it here too.</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="14px" color="#61667C" line-height="1.6" padding="0">One activation inside HitPay. No Malaysian bank account. No entity setup. MYR payments settled in SGD automatically.</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="16px 32px 16px">
    <mj-column>
      <mj-image src="/Users/riacorral/Documents/HitPay-Claude/hitpay-edm-main/emails/images/duitnow-pos-qr.jpg" alt="DuitNow QR on HitPay POS" border-radius="8px" padding="0" />
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 24px">
    <mj-column>
      <mj-divider border-color="#D4D9E0" border-width="1px" padding="8px 0 0" />
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="24px" font-weight="700" color="#002771" line-height="1.3" padding="0">Why This Is a Big Opportunity for SG Merchants</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="16px 32px 24px">
    
    <mj-column width="42%" vertical-align="middle" padding="0 16px 0 0" css-class="img-col">
      <mj-image src="/Users/riacorral/Documents/HitPay-Claude/hitpay-edm-main/emails/images/malaysia-visitors.png" alt="" padding="0" />
    </mj-column>
    <mj-column width="58%" vertical-align="middle" padding="0">
      <mj-raw>
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:20px;">
  <tr>
    <td width="24" valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:16px;font-weight:700;color:#2465DE;line-height:1.4;padding:0;white-space:nowrap;">•</td>
    <td valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;padding:0 0 0 4px;">
      <div style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:16px;font-weight:700;color:#03102F;line-height:1.4;margin:0 0 4px 0;">Massive Cross-Border Traffic</div>
      <div style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:14px;font-weight:400;color:#61667C;line-height:1.6;">Malaysia is one of Singapore's largest inbound visitor markets. From Johor day-trippers to Kuala Lumpur tourists, this is a high-frequency spending segment.</div>
    </td>
  </tr>
</table>
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:20px;">
  <tr>
    <td width="24" valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:16px;font-weight:700;color:#2465DE;line-height:1.4;padding:0;white-space:nowrap;">•</td>
    <td valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;padding:0 0 0 4px;">
      <div style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:16px;font-weight:700;color:#03102F;line-height:1.4;margin:0 0 4px 0;">High Banking App Adoption</div>
      <div style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:14px;font-weight:400;color:#61667C;line-height:1.6;">DuitNow QR is embedded inside major Malaysian banking apps. For many customers, it's their default way to pay. If you don't offer it, you risk friction at checkout, especially for impulse retail and F&amp;B purchases.</div>
    </td>
  </tr>
</table>
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:0;">
  <tr>
    <td width="24" valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:16px;font-weight:700;color:#2465DE;line-height:1.4;padding:0;white-space:nowrap;">•</td>
    <td valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;padding:0 0 0 4px;">
      <div style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:16px;font-weight:700;color:#03102F;line-height:1.4;margin:0 0 4px 0;">Trusted &amp; Recognisable</div>
      <div style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:14px;font-weight:400;color:#61667C;line-height:1.6;">Malaysian shoppers actively look for the DuitNow logo. It signals familiarity, security, and confidence to complete the transaction.</div>
    </td>
  </tr>
</table></mj-raw>
    </mj-column>
  </mj-section>
