  <mj-section padding="16px 32px 24px">
    <mj-column>
      <mj-button href="https://hitpayapp.com/hitpay-borderless-qr-payments" background-color="#2465DE" color="#FFFFFF" border-radius="6px" font-size="16px" font-weight="600" inner-padding="12px 24px" align="center">Start using DuitNow with Borderless QR Today</mj-button>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 24px">
    <mj-column>
      <mj-divider border-color="#D4D9E0" border-width="1px" padding="8px 0 0" />
