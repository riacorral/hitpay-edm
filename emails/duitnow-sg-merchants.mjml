      <mj-divider border-color="#D4D9E0" border-width="1px" padding="8px 0 0" />
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="24px" font-weight="700" color="#002771" line-height="1.3" padding="0">Cross Border Payment Details</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="14px" color="#61667C" line-height="1.6" padding="0"><b style="color:#03102F;">Online Fee:</b> 2.3% per transaction</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="14px" color="#61667C" line-height="1.6" padding="0"><b style="color:#03102F;">In-Person (POS) Fee:</b> 1.5% per transaction</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="14px" color="#61667C" line-height="1.6" padding="0"><b style="color:#03102F;">Settlement Currency:</b> Settled in SGD (converted automatically from MYR)</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="14px" color="#61667C" line-height="1.6" padding="0"><b style="color:#03102F;">Settlement Time:</b> T+3 (Cross-Border)</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="14px" color="#61667C" line-height="1.6" padding="0"><b style="color:#03102F;">Refunds:</b> Fully supported, including partial refunds</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="14px" color="#61667C" line-height="1.6" padding="0"><b style="color:#03102F;">Channels:</b> Online Web Redirect &amp; POS / Quick Sale (Dynamic QR)</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 24px">
