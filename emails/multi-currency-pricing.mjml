<mjml>
  <mj-head>
    <mj-font name="Manrope" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&display=swap" />
    <mj-preview>Keep full control over your product pricing while customers pay in their local currency.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif" />
      <mj-section padding="0" background-color="#FFFFFF" />
      <mj-column padding="0" />
      <mj-text font-family="Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif" padding="0" />
      <mj-image padding="0" />
    </mj-attributes>
    <mj-style>
      a { color: inherit; text-decoration: none; }
      p { margin: 0 !important; }
      @media only screen and (max-width:480px) {
        /* Add gap below image when image+text block stacks on mobile */
        .img-col { padding-bottom: 20px !important; }
        /* Stack stat/column cards vertically on mobile */
        table.col-wrap tr { display: block !important; }
        td.col-card { display: block !important; width: 100% !important; max-width: 100% !important; box-sizing: border-box !important; margin-bottom: 8px !important; }
        td.col-spacer { display: none !important; width: 0 !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F0F2F5" width="600px">
    
  <mj-section background-color="#002771" padding="48px 32px 0">
    <mj-column>
      <mj-text align="center" font-size="11px" font-weight="600" color="#D4D9E0" letter-spacing="1.5px" text-transform="uppercase" padding="0 0 8px">🌏 New · POS Feature</mj-text>
      <mj-text align="center" font-size="28px" font-weight="700" color="#FFFFFF" line-height="1.2" padding="0 0 16px">Selling at overseas events?<br/>Price like a local on your HitPay POS today.</mj-text>
      
      <mj-image src="img/multi-currency-hero-v3.png" alt="Selling at overseas events?
Price like a local on your HitPay POS today." border-radius="8px 8px 0 0" padding="0" />
    </mj-column>
  </mj-section>
    <mj-section padding="32px 0 0" background-color="#FFFFFF"><mj-column /></mj-section>
    
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="14px" color="#61667C" line-height="1.6" padding="0">Hi {firstName},</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="14px" color="#61667C" line-height="1.6" padding="0">We've heard your requests — especially from partners growing their business through overseas retail events like Boutique Asia in Bangkok, Coffee Expo in Malaysia, and many more.</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="14px" color="#61667C" line-height="1.6" padding="0">You can now set exact prices for the same product in <b style="color:#03102F;">ANY</b> currency — right on HitPay POS. No live exchange rates, no manual conversion. You decide what a product costs in each currency, and your customers pay in the one they know.</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 24px">
    <mj-column>
      <mj-divider border-color="#D4D9E0" border-width="1px" padding="8px 0 0" />
    </mj-column>
  </mj-section>
  <mj-section padding="16px 32px 24px">
    <mj-column>
      <mj-text font-size="16px" font-weight="700" color="#002771" line-height="1.3" padding="0">How to Set It Up</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-raw>
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:12px;">
  <tr>
    <td width="24" valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:14px;font-weight:700;color:#2465DE;line-height:1.6;padding:0;white-space:nowrap;">1.</td>
    <td valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:14px;color:#61667C;line-height:1.6;padding:0 0 0 8px;">Go to <b style="color:#03102F;">Point of Sale &gt; Products</b> on your dashboard</td>
  </tr>
</table>
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:12px;">
  <tr>
    <td width="24" valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:14px;font-weight:700;color:#2465DE;line-height:1.6;padding:0;white-space:nowrap;">2.</td>
    <td valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:14px;color:#61667C;line-height:1.6;padding:0 0 0 8px;">Open an existing product or create a new one</td>
  </tr>
</table>
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:12px;">
  <tr>
    <td width="24" valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:14px;font-weight:700;color:#2465DE;line-height:1.6;padding:0;white-space:nowrap;">3.</td>
    <td valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:14px;color:#61667C;line-height:1.6;padding:0 0 0 8px;">Under <b style="color:#03102F;">Pricing</b>, click <b style="color:#03102F;">Add a price by currency</b></td>
  </tr>
</table>
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:12px;">
  <tr>
    <td width="24" valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:14px;font-weight:700;color:#2465DE;line-height:1.6;padding:0;white-space:nowrap;">4.</td>
    <td valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:14px;color:#61667C;line-height:1.6;padding:0 0 0 8px;">Select the currency and enter your price</td>
  </tr>
</table>
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:0;">
  <tr>
    <td width="24" valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:14px;font-weight:700;color:#2465DE;line-height:1.6;padding:0;white-space:nowrap;">5.</td>
    <td valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:14px;color:#61667C;line-height:1.6;padding:0 0 0 8px;">Repeat for each currency, then <b style="color:#03102F;">Save</b></td>
  </tr>
</table></mj-raw>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="14px" color="#61667C" line-height="1.6" padding="0">Here's step 3 on your dashboard — the Selling price section, with Add price by currency:</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="16px 32px 16px">
    <mj-column>
      <mj-image src="img/multi-currency-howto-step3.png" alt="Selling price section on a HitPay product page, with Add price by currency highlighted" border-radius="8px" padding="0" />
    </mj-column>
  </mj-section>
  <mj-section padding="16px 32px 24px">
    <mj-column>
      <mj-button href="https://dashboard.hit-pay.com/?utm_source=email&amp;utm_medium=email&amp;utm_campaign=multi-currency-pricing&amp;utm_content=1-price-your-products-in-different-currencies-now" background-color="#2465DE" color="#FFFFFF" border-radius="6px" font-size="16px" font-weight="600" inner-padding="12px 24px" align="center">Price Your Products In Different Currencies Now</mj-button>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 24px">
    <mj-column>
      <mj-divider border-color="#D4D9E0" border-width="1px" padding="8px 0 0" />
    </mj-column>
  </mj-section>
  <mj-section padding="16px 32px 24px">
    <mj-column>
      <mj-text font-size="16px" font-weight="700" color="#002771" line-height="1.3" padding="0">Set Prices Your Way</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-raw>
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:20px;">
  <tr>
    <td width="24" valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:16px;font-weight:700;color:#2465DE;line-height:1.4;padding:0;white-space:nowrap;">•</td>
    <td valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;padding:0 0 0 4px;">
      <div style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:16px;font-weight:700;color:#03102F;line-height:1.4;margin:0 0 4px 0;">Set your own price, per currency</div>
      <div style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:14px;font-weight:400;color:#61667C;line-height:1.6;">No surprises from exchange rate swings — you decide exactly what a product costs, market by market.</div>
    </td>
  </tr>
</table>
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:20px;">
  <tr>
    <td width="24" valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:16px;font-weight:700;color:#2465DE;line-height:1.4;padding:0;white-space:nowrap;">•</td>
    <td valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;padding:0 0 0 4px;">
      <div style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:16px;font-weight:700;color:#03102F;line-height:1.4;margin:0 0 4px 0;">Switch currencies in seconds</div>
      <div style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:14px;font-weight:400;color:#61667C;line-height:1.6;">Change your Web POS checkout currency before a sale, and prices update instantly.</div>
    </td>
  </tr>
</table>
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:0;">
  <tr>
    <td width="24" valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:16px;font-weight:700;color:#2465DE;line-height:1.4;padding:0;white-space:nowrap;">•</td>
    <td valign="top" style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;padding:0 0 0 4px;">
      <div style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:16px;font-weight:700;color:#03102F;line-height:1.4;margin:0 0 4px 0;">Falls back automatically</div>
      <div style="font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;font-size:14px;font-weight:400;color:#61667C;line-height:1.6;">Haven't set a price for a currency yet? HitPay converts from your home currency in real time.</div>
    </td>
  </tr>
</table></mj-raw>
    </mj-column>
  </mj-section>
  <mj-section padding="16px 32px 24px">
    <mj-column>
      <mj-button href="https://docs.hitpayapp.com/pos/multi-currency-products?utm_source=email&amp;utm_medium=email&amp;utm_campaign=multi-currency-pricing&amp;utm_content=2-prepare-for-overseas-selling-today#multi-currency-products" background-color="#2465DE" color="#FFFFFF" border-radius="6px" font-size="16px" font-weight="600" inner-padding="12px 24px" align="center">Prepare for Overseas Selling Today</mj-button>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 24px">
    <mj-column>
      <mj-divider border-color="#D4D9E0" border-width="1px" padding="8px 0 0" />
    </mj-column>
  </mj-section>
  <mj-section padding="16px 32px 24px">
    <mj-column>
      <mj-text font-size="16px" font-weight="700" color="#002771" line-height="1.3" padding="0">Who Is This For?</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 24px">
    <mj-column padding="0">
      <mj-raw><table class="col-wrap" width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation"><tbody><tr><td width="173" class="col-card" valign="top" bgcolor="#F5F7FC" align="center" style="background-color:#F5F7FC;border-radius:8px;padding:16px 12px;width:173px;text-align:center;">
          <div style="text-align:center;font-size:20px;line-height:1.2;margin:0 0 6px 0;font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;">🌏</div><p style="text-align:center;font-size:12px;color:#61667C;line-height:1.6;margin:6px 0 0 0;font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;">Cross-border partners selling at trade fairs or pop-up events</p>
        </td><td width="8" class="col-spacer" style="width:8px;font-size:0;line-height:0;"> </td><td width="173" class="col-card" valign="top" bgcolor="#F5F7FC" align="center" style="background-color:#F5F7FC;border-radius:8px;padding:16px 12px;width:173px;text-align:center;">
          <div style="text-align:center;font-size:20px;line-height:1.2;margin:0 0 6px 0;font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;">🏪</div><p style="text-align:center;font-size:12px;color:#61667C;line-height:1.6;margin:6px 0 0 0;font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;">Retail businesses operating across multiple Southeast Asian markets</p>
        </td><td width="8" class="col-spacer" style="width:8px;font-size:0;line-height:0;"> </td><td width="173" class="col-card" valign="top" bgcolor="#F5F7FC" align="center" style="background-color:#F5F7FC;border-radius:8px;padding:16px 12px;width:173px;text-align:center;">
          <div style="text-align:center;font-size:20px;line-height:1.2;margin:0 0 6px 0;font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;">⚡</div><p style="text-align:center;font-size:12px;color:#61667C;line-height:1.6;margin:6px 0 0 0;font-family:Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;">Anyone tired of manual FX math slowing down checkout</p>
        </td></tr></tbody></table></mj-raw>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="14px" color="#61667C" line-height="1.6" padding="0">Now Available on your HitPay Dashboard Web POS and HitPay Mobile POS App (iOS &amp; Android devices).</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 24px">
    <mj-column>
      <mj-divider border-color="#D4D9E0" border-width="1px" padding="8px 0 0" />
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="14px" color="#61667C" line-height="1.6" padding="0">Questions? Reply to this email and we will help you out.</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text font-size="14px" color="#61667C" line-height="1.6" padding="0">— The HitPay Team</mj-text>
    </mj-column>
  </mj-section>
    
    
  
