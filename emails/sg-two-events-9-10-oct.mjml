<mjml>
  <mj-head>
    <mj-font name="Manrope" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&display=swap" />
    <mj-preview>A live HitPay walkthrough on 9 Oct and a hands-on AI workshop on 10 Oct.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif" />
      <mj-section padding="0" background-color="#FFFFFF" />
      <mj-column padding="0" />
      <mj-text font-family="Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif" padding="0" />
      <mj-image padding="0" />
    </mj-attributes>
    <mj-style>
      a { color: inherit; text-decoration: none; }
      p { margin: 0 !important; }
      /* Mobile-order (text, then image) duplicate of img-text-wrap — hidden until the
         mobile breakpoint swaps it in, so degradation without media-query support
         still shows the (desktop-ordered) img-text-wrap table rather than nothing. */
      table.img-text-mobile { display: none; }
      @media only screen and (max-width:480px) {
        /* Swap to the mobile-ordered table instead of stacking img-text-wrap in
           place, since img-text-wrap's column order follows desktop imagePosition
           (image can be first) and we always want text before image on mobile. */
        table.img-text-wrap { display: none !important; }
        table.img-text-mobile { display: block !important; }
        table.img-text-mobile tr { display: block !important; }
        table.img-text-mobile td.img-text-img,
        table.img-text-mobile td.img-text-body { display: block !important; width: 100% !important; max-width: 100% !important; box-sizing: border-box !important; padding: 0 !important; }
        table.img-text-mobile td.img-text-img { padding-top: 16px !important; }
        table.img-text-mobile td.img-text-img img { width: 100% !important; height: auto !important; }
        /* Stack stat/column cards vertically on mobile */
        table.col-wrap tr { display: block !important; }
        td.col-card { display: block !important; width: 100% !important; max-width: 100% !important; box-sizing: border-box !important; margin-bottom: 8px !important; }
        td.col-spacer { display: none !important; width: 0 !important; }
        /* Wrap secondary eyebrow pill text onto its own line */
        .eyebrow-sep { display: none !important; }
        .eyebrow-break { display: block !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F0F2F5" width="600px">
    
  <mj-section background-color="#FFFFFF" padding="16px 32px">
    <mj-column>
      <mj-image src="img/inline-1.png" alt="HitPay" width="120" align="left" padding="0" />
    </mj-column>
  </mj-section>
  <mj-section background-color="#FFFFFF" padding="8px 32px 24px">
    <mj-column>
      <mj-text font-size="28px" font-weight="700" color="#002771" line-height="1.3" padding="0">2 sessions this week. Limited seats left.</mj-text>
      
    </mj-column>
  </mj-section>
    <mj-section padding="32px 0 0" background-color="#FFFFFF"><mj-column /></mj-section>
    
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text align="left" font-size="14px" color="#61667C" line-height="1.6" padding="0">Hi {firstName},</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 16px">
    <mj-column>
      <mj-text align="left" font-size="14px" color="#61667C" line-height="1.6" padding="0">Two HitPay sessions are happening in Singapore this week, and seats are limited.</mj-text>
    </mj-column>
  </mj-section>
  <mj-section padding="0 32px 24px">
    <mj-column>
      <mj-raw><table width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #D4D9E0;border-radius:12px;border-collapse:separate;background-color:#FFFFFF;">
<tr><td style="padding:24px 24px 20px 24px;">
  <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
    <td width="64" valign="top" style="width:64px;">
      <table width="64" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" bgcolor="#002771" style="background-color:#002771;border-radius:8px;padding:10px 0 8px 0;text-align:center;">
        <div style="font-family:Hauora, Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;font-size:26px;font-weight:700;color:#FFFFFF;line-height:1;">9</div>
        <div style="font-family:Hauora, Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#FFFFFF;line-height:1.4;margin-top:4px;">Oct</div>
        <div style="font-family:Hauora, Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;font-size:10px;text-transform:uppercase;letter-spacing:0.5px;color:#B8C4DE;line-height:1.4;">Fri</div>
      </td></tr></table>
    </td>
    <td valign="top" style="padding-left:16px;">
      <table cellpadding="0" cellspacing="0" border="0" style="margin:0 0 8px 0;"><tr><td style="background-color:#EBF0FA;border-radius:12px;padding:3px 10px;font-family:Hauora, Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;font-size:11px;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;color:#002771;">Online · Webinar</td></tr></table>
      <div style="font-family:Hauora, Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;font-size:18px;font-weight:700;color:#002771;line-height:1.3;margin:0 0 6px 0;">Run Your Business Better with HitPay</div>
      <div style="font-family:Hauora, Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;font-size:13px;font-weight:600;color:#03102F;line-height:1.6;">3–4pm SGT<br/>Online</div>
    </td>
  </tr></table>
</td></tr>
<tr><td style="padding:0 24px 20px 24px;"><img src="img/runurbiz.jpg" alt="Run your business better with HitPay" width="100%" style="display:block;width:100%;max-width:100%;height:auto;border-radius:8px;border:0;" /></td></tr><tr><td style="padding:0 24px 16px 24px;"><div style="font-family:Hauora, Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#2465DE;line-height:1.4;margin:0 0 6px 0;">Who it's for</div><div style="font-family:Hauora, Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;font-size:14px;color:#61667C;line-height:1.6;">Business owners who want to use HitPay beyond taking payments, from paying suppliers to serving overseas customers at the counter.</div></td></tr><tr><td style="padding:0 24px 16px 24px;"><div style="font-family:Hauora, Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#2465DE;line-height:1.4;margin:0 0 6px 0;">What you'll take away</div><table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:8px;"><tr>
<td width="18" valign="top" style="font-family:Hauora, Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;font-size:14px;font-weight:700;color:#2465DE;line-height:1.6;">&#10003;</td>
<td valign="top" style="font-family:Hauora, Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;font-size:14px;color:#61667C;line-height:1.6;padding-left:6px;">How to collect bank transfers through Collection Account and match invoice payments automatically</td>
</tr></table><table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:8px;"><tr>
<td width="18" valign="top" style="font-family:Hauora, Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;font-size:14px;font-weight:700;color:#2465DE;line-height:1.6;">&#10003;</td>
<td valign="top" style="font-family:Hauora, Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;font-size:14px;color:#61667C;line-height:1.6;padding-left:6px;">How to pay local and international suppliers with BillPay, and where Xero integration fits</td>
</tr></table><table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:0;"><tr>
<td width="18" valign="top" style="font-family:Hauora, Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;font-size:14px;font-weight:700;color:#2465DE;line-height:1.6;">&#10003;</td>
<td valign="top" style="font-family:Hauora, Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;font-size:14px;color:#61667C;line-height:1.6;padding-left:6px;">How to accept overseas wallets with Borderless QR, set foreign-currency prices with Multi-Currency POS, and use card readers</td>
</tr></table></td></tr><tr><td style="padding:0 24px 20px 24px;"><div style="background-color:#F5F7FC;border-radius:8px;padding:12px 14px;font-family:Hauora, Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;font-size:13px;color:#61667C;line-height:1.6;">A live walkthrough of managing money coming in, money going out, and payments at your counter. <b style="color:#03102F;">Limited seats left.</b> Registration is subject to approval.</div></td></tr><tr><td style="padding:0 24px 24px 24px;"><table cellpadding="0" cellspacing="0" border="0"><tr><td bgcolor="#2465DE" style="background-color:#2465DE;border-radius:6px;"><a href="https://luma.com/gfrd2dj2?utm_source=email&amp;utm_medium=email&amp;utm_campaign=sg-two-events-9-10-oct&amp;utm_content=1-register-for-the-webinar" style="display:inline-block;padding:12px 24px;font-family:Hauora, Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;font-size:15px;font-weight:600;color:#FFFFFF;text-decoration:none;">Register for the webinar →</a></td></tr></table></td></tr>
</table></mj-raw>
    </mj-column>
